# Copy this file to `.env` and fill in real values. Never commit `.env`.

# S3 credentials (required)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Only needed for temporary credentials
AWS_SESSION_TOKEN=

# Optional: region of the bucket
AWS_DEFAULT_REGION=us-east-2

# Optional: name of the bucket
BUCKET_NAME=factored-datathon-2026-s3-157725502942-us-east-2-an

# Optional: for S3-compatible services such as MinIO (e.g. http://localhost:9000)
AWS_ENDPOINT_URL=

# Neon Postgres (required): the FULL connection string Neon gives you, not just a hostname.
NEON_DB_HOST=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# krtr-web (`krtr back web serve`). The app records every event in Neon's `events` table, so in
# production (the default) it refuses to start without KRTR_EVENTS_KEY and NEON_DB_HOST.
# KRTR_WEB_ENVIRONMENT=development lets it run without them (events are not recorded) and
# turns on /docs. Generate a key with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# KRTR_WEB_ENVIRONMENT=development
# KRTR_EVENTS_KEY=

# Neon roles created by SQL in task 1.3 (least privilege, unlike console-created roles). The same
# passwords work on `production` and on `dev`, which was branched from it. Ask the team for them.
# KRTR_APP_DB_PASSWORD=
# KRTR_KEYCLOAK_DB_PASSWORD=
# KRTR_AUDIT_DB_PASSWORD=
# Full connection string of the Neon `dev` branch (role neondb_owner, database neondb, pooled),
# for local development. NEON_DB_HOST above stays the `production` one.
# NEON_DEV_DB_HOST=

# Local Keycloak (krtr/back/security/keycloak/docker-compose.yml). The direct (non-pooled) host of
# the dev branch: NEON_DEV_DB_HOST's host without `-pooler`. And the password of the local
# bootstrap admin (user `admin`), which only exists in the dev branch's master realm.
# NEON_DEV_DIRECT_HOST=
# KRTR_KEYCLOAK_ADMIN_PASSWORD=

# Modal (optional, only for `--remote` / `--detach`). Either set the token below, or leave all of
# it commented out to use the profile saved in ~/.modal.toml (`modal token new`).
# Keep these commented until you have real values: an EMPTY MODAL_TOKEN_ID / MODAL_TOKEN_SECRET
# is not ignored, it makes Modal fail with "Token missing" instead of using your profile.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# MODAL_PROFILE=            # optional: which profile of ~/.modal.toml to use when no token is set
